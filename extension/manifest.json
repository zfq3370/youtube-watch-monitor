{
  "manifest_version": 3,
  "name": "YouTube 多任务监控助手",
  "version": "2.2.2",
  "description": "按桌面程序配置监控指定评论、博主置顶评论和会员专属新视频。",
  "permissions": ["alarms", "storage", "webNavigation", "scripting"],
  "host_permissions": ["https://www.youtube.com/*", "http://127.0.0.1:18964/*"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "YouTube 多任务监控助手",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "content_scripts": [{
    "matches": ["https://www.youtube.com/*"],
    "js": ["reader.js", "content.js"],
    "run_at": "document_idle"
  }]
}
