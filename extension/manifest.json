{
  "manifest_version": 3,
  "name": "YouTube 多任务监控助手",
  "version": "2.1.0",
  "description": "按桌面程序配置监控指定评论、博主置顶评论和会员专属新视频。",
  "permissions": ["alarms", "storage", "webNavigation", "scripting"],
  "host_permissions": ["https://www.youtube.com/*", "http://127.0.0.1:18964/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "YouTube 多任务监控助手" },
  "content_scripts": [{
    "matches": ["https://www.youtube.com/*"],
    "js": ["reader.js", "content.js"],
    "run_at": "document_idle"
  }]
}
